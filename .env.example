# Copy to .env. Never commit credentials or learner data.
# disabled: inspect/import local data; demo: synthetic FSM walkthrough;
# openai: real tutoring through an OpenAI-compatible endpoint.
TUTOR_PROVIDER=disabled
# strict: provider-enforced JSON Schema; compatibility: streamed JSON with local validation.
TUTOR_OPENAI_MODE=strict
OPENAI_BASE_URL=https://api.openai.com/v1
TUTOR_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Required as the x-tutair-canonical-token header for canonical YAML imports.
TUTOR_CANONICAL_IMPORT_TOKEN=

# Local CPU embeddings need no API key. First use downloads a pinned model.
TUTOR_EMBEDDING_PROVIDER=local
# For remote embeddings: use openai above and set a compatible model below.
# TUTOR_EMBEDDING_MODEL=text-embedding-3-small
# TUTOR_MODEL_CACHE=/home/dim-agent/.cache/tutair/models

# The app defaults to 3000; DIM's shared gateway exposes it on a separate URL.
# PORT=3000
# TUTOR_INGRESS=https-ts
